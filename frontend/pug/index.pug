								img(src="./public/img/x.svg", alt="Partners")
							a.header__logo_2(href="#")
								img(src="./public/img/logo-partners.svg", alt="Motor")
					.section-1__text_block
						.section-1__heading 
							h1 Make money on your 
								br
								| gambling traffic!
						.section-1__btn_block
							a.btn(href="https://www.google.com/")
								span Become Partner
				section.section-2 
					.section-2__items.vis_on_scroll
						.section-2__item
							.section-2__item_icon 
								img(src="./public/img/icon-1.png", alt="")
