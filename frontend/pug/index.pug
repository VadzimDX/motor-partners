						img(src="./public/img/bg-2.png", alt="")
					.section-2__shine 
						img(src="./public/img/shine-1.png", alt="")
				section.section-3 
					.section-3__main.vis_on_scroll  
						.section-3__text_block
							.section-3__heading 
								h3 Become our partner and 
									br
									| make money on your 
									br
									| gambling traffic!	
							.section-3__text 
								p Top commissions made for better affiliate performance. 
									span RevShare deal, CPA and Hybrid 
									| ― we can tune it up to your traffic.Convenient and highly detailed statistics. Includes 
									br
									span all basic KPIs
									|, player profiles and even the games list. 
							.section-3__btn_block 
								a.btn(href="https://www.google.com/")
									span Become Partner	
