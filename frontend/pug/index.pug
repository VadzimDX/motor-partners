							a.btn(href="https://www.google.com/")
								span Become Partner	
					.section-4__shine_1
						img(src="./public/img/shine-3.png", alt="")
					.section-4__bg_1
						img(src="./public/img/bg-3.png", alt="")
				
				footer.footer.vis_on_scroll
					.footer__bg_mob 
