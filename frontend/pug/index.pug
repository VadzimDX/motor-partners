							a.footer__logo(href="#")
								img(src="./public/img/logo.svg", alt="Motor")
							.footer__x 
								img(src="./public/img/x.svg", alt="Partners")
							a.footer__logo_2(href="#")
								img(src="./public/img/logo-partners.svg", alt="Motor")
						.footer__soc_block
							.footer__text 
								span MotorSupport
							a.footer__email(href="mailto:support@motorpartners.com")
								img(src="./public/img/mail-icon.png", alt="")
								span support@motorpartners.com
							.footer__copyrights
								span Motor Partners © 2025



